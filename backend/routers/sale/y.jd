  console.log(`📞 GET /check-stock/health endpoint hit`);
  
  res.json({
    success: true,
    message: "Stock check endpoint is working",
    version: "3.0 - Batch-Based Stock Management",
    endpoints: {
      individualCheck: "POST /check-stock",
      currentStock: "GET /current-stock/:productName",
      productCheck: "GET /products/check/:productName",
      importWithDeduction: "POST /import-with-stock-deduction",
      progress: "GET /import/progress/:sessionId",
      failedInvoices: "GET /import/failed/:sessionId",
    },
    timestamp: new Date().toISOString(),
  });
});

