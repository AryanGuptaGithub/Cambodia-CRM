// Product existence check
router.get("/products/check/:productName", async (req, res) => {
  console.log(`📞 GET /products/check/${req.params.productName} endpoint hit`);
  
  try {
    const { productName } = req.params;

    if (!productName || productName.trim() === "") {
      return res.status(400).json({
        success: false,
        message: "Product name is required",
        exists: false,
        product: null,
      });
    }

    const decodedProductName = decodeURIComponent(productName);
    console.log(`🔍 Checking product: "${decodedProductName}"`);
    
    const product = await findProductByName(decodedProductName);
    
    if (!product) {
      // Check in Product catalog
      const catalogProduct = await Product.findOne({
        productName: { $regex: new RegExp(`^${escapeRegex(normalizeProductName(decodedProductName))}$`, "i") }
      });

      console.log(`📦 Product not in inventory, catalog check: ${catalogProduct ? 'Found' : 'Not found'}`);
      
      return res.json({
        success: true,
        exists: !!catalogProduct,
        inInventory: false,
        inCatalog: !!catalogProduct,
        product: catalogProduct ? {
          name: catalogProduct.productName,
          id: catalogProduct._id,
        } : null,
        message: catalogProduct 
          ? "Product exists in catalog but not in inventory. Please import purchase inventory."
          : "Product not found in system."
      });
    }

    console.log(`✅ Product found in inventory: "${product.productName}"`);
    
    res.json({
      success: true,
      exists: true,
      inInventory: true,
      product: {
        name: product.productName,
        id: product._id,
        stock: product.totalBoxes || 0,
        batches: product.batches || [],
        batchCount: product.batches ? product.batches.length : 0
      },
    });
  } catch (error) {
    console.error(`💥 Error checking product:`, error);
    res.status(500).json({
      success: false,
      exists: false,
      message: error.message,
      product: null,
    });
  }
});

// Get sales with pagination
router.get("/", async (req, res) => {
  console.log(`📞 GET /sales endpoint hit with query:`, req.query);
  
  try {
    const { page = 1, limit = 9, search = "", tab = "All" } = req.query;

    const pageNum = parseInt(page);
    const limitNum = parseInt(limit);
    const skip = (pageNum - 1) * limitNum;

    const matchConditions = {};

    if (search && search.trim() !== "") {
      const searchRegex = new RegExp(search.trim(), "i");
      matchConditions.$or = [
        { invoiceNumber: searchRegex },
        { customerName: searchRegex },
        { "products.productName": searchRegex },
      ];
    }

    if (tab && tab !== "All") {
      matchConditions.paymentStatus = new RegExp(`^${tab}$`, "i");
    }

    const totalCount = await SaleSummary.countDocuments(matchConditions);
    const totalPages = Math.ceil(totalCount / limitNum);

    const summaries = await SaleSummary.find(matchConditions)
      .sort({ recordingDate: -1 })
      .skip(skip)
      .limit(limitNum)
      .select({
        recordingDate: 1,
        invoiceNumber: 1,
        invoiceDate: 1,
        mrName: 1,
        mrId: 1,
        customerCode: 1,
        customerId: 1,
        customerName: 1,
        paymentStatus: 1,
        remark: 1,
        creditDays: 1,
        dueDate: 1,
        deliveryDate: 1,
        paidAmount: 1,
        dueAmount: 1,
        totalAmount: 1,
        totalProfitLoss: 1,
        products: 1,
        createdAt: 1,
        updatedAt: 1,
      });

    console.log(`📊 Retrieved ${summaries.length} sales records`);
    
    res.status(200).json({
      summaries,
      pagination: {
        currentPage: pageNum,
        totalPages,
        totalCount,
        hasNext: pageNum < totalPages,
        hasPrev: pageNum > 1,
      },
    });
  } catch (error) {
    console.error(`💥 Error fetching sales:`, error);
    res.status(500).json({ message: "Failed to fetch sale summaries." });
  }
});

