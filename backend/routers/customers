router.post("/customers/import", async (req, res) => {
  try {
    const customers = req.body;
    console.log("📦 [IMPORT] Payload received:", customers);

    // Validate that the input is an array
    if (!Array.isArray(customers)) {
      console.log("❌ [IMPORT] Invalid payload format — expected an array.");
      return res.status(400).json({
        message: "Invalid data format. Expected an array of customers.",
      });
    }

    for (const customer of customers) {

      // Validate required fields
      if (
        !customer.name ||
        !customer.phone ||
        !customer.email ||
        !customer.warehouse
      ) {
        console.log("❌ [IMPORT] Missing required fields:", customer);
        return res.status(400).json({
          message: "Missing required fields in one or more records.",
        });
      }

      // Try to create the customer
      try {
        console.log("📤 [IMPORT] Attempting to create customer:", customer.email);
        await Customer.create(customer);
        console.log("✅ [IMPORT] Customer created:", customer.email);
      } catch (err) {
        console.error("⚠️ [IMPORT] Error creating customer:", err);

        // Handle MongoDB duplicate key error
        if (err.code === 11000) {
          let duplicateField = "field";
          let duplicateValue = "value";

          try {
            duplicateField = Object.keys(err.keyPattern || {})[0];
            duplicateValue = err.keyValue?.[duplicateField] || "Unknown";
            console.warn(`⚠️ [IMPORT] Duplicate key detected — ${duplicateField}: ${duplicateValue}`);
          } catch (parseErr) {
            console.error("❌ [IMPORT] Error parsing duplicate field info:", parseErr);
          }

          return res.status(400).json({
            message: `A customer with this ${duplicateField} <b style="color:#EF4444">${duplicateValue}</b> already exists.`,
            field: duplicateField,
            ok: false,
          });
        }

        // Other validation or database errors
        console.error("❌ [IMPORT] Validation/database error:", err.message);
        return res.status(400).json({
          message: "Invalid data provided.",
          error: err.message,
          ok: false,
        });
      }
    }

    console.log("🎉 [IMPORT] All customers imported successfully.");
    res.status(200).json({ message: "Customers imported successfully." });

  } catch (err) {
    console.error("🔥 [IMPORT] Unexpected server error:", err);
    res.status(500).json({ message: "Failed to import customers." });
  }
});

module.exports = router;
